<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="controlles.StatsWindowController"
          hgap="12" vgap="6"
          >
    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>

    <Label text="FPS:"           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
    <Label fx:id="fpsLabel"      GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="Кадров:"        GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <Label fx:id="frameLabel"    GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Шаров:"         GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <Label fx:id="ballCountLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="Макс. скорость:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <Label fx:id="maxSpeedLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <Label text="Ср. скорость:"   GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <Label fx:id="avgSpeedLabel"  GridPane.columnIndex="1" GridPane.rowIndex="4"/>

    <Label text="Кин. энергия:"   GridPane.columnIndex="0" GridPane.rowIndex="5"/>
    <Label fx:id="energyLabel"    GridPane.columnIndex="1" GridPane.rowIndex="5"/>

    <Label text="Вращат. энергия:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
    <Label fx:id="rotEnergyLabel"  GridPane.columnIndex="1" GridPane.rowIndex="6"/>

    <Label text="Полная энергия:"  GridPane.columnIndex="0" GridPane.rowIndex="7"/>
    <Label fx:id="totalEnergyLabel" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

    <Label text="Проверок пар:"   GridPane.columnIndex="0" GridPane.rowIndex="8"/>
    <Label fx:id="checksLabel"    GridPane.columnIndex="1" GridPane.rowIndex="8"/>

    <Label text="Столкновений:"   GridPane.columnIndex="0" GridPane.rowIndex="9"/>
    <Label fx:id="collisionsLabel" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

    <Label text="Физика:"         GridPane.columnIndex="0" GridPane.rowIndex="10"/>
    <Label fx:id="physicsLabel"   GridPane.columnIndex="1" GridPane.rowIndex="10"/>
</GridPane>