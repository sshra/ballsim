<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controlles.GroupEditController"
      spacing="10">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <Label text="Имя:"/>
    <TextField fx:id="nameField"/>

    <Label text="Количество:"/>
    <Spinner fx:id="countSpinner" editable="true"/>

    <Label text="Радиус:"/>
    <TextField fx:id="radiusField"/>

    <Label text="Вес:"/>
    <TextField fx:id="massField"/>

    <Label text="Трение (μ):"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Slider fx:id="muSlider"
                min="0.0" max="1.0"
                value="0.3"
                showTickLabels="true"
                showTickMarks="true"
                majorTickUnit="0.25"
                minorTickCount="4"
                blockIncrement="0.05"
                HBox.hgrow="ALWAYS"/>
        <Label fx:id="muValueLabel" text="0.30" minWidth="40"/>
    </HBox>

    <Label text="Цвет:"/>
    <ColorPicker fx:id="colorPicker"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Отмена" onAction="#onCancel"/>
        <Button text="OK" onAction="#onApply" defaultButton="true"/>
    </HBox>
</VBox>